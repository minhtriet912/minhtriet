#!name=Locket Custom Edition
#!desc=Crack By NVMT | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script1.sgmodule?token=GHSAT0AAAAAAEMU5J5MSFHX3QZAAAPUN6XM2WUTJLQ, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by nguyencongan)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script2.sgmodule?token=GHSAT0AAAAAAEMU5J5MAMU5IM7DOCSD5WRA2WUTJYQ, timeout=60

# 3. Kích hoạt Gold & Ngày 25/05/1111 (by nguyencongan)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script3.sgmodule?token=GHSAT0AAAAAAEMU5J5NCWGMNJK2G6DHRS3U2WUTJ5A, requires-body=true, max-size=-1, timeout=60
