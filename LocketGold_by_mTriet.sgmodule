#!name=Locket Custom Edition
#!desc=Crack By NVMT | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script1.js?token=GHSAT0AAAAAAEMU5J5MEZIYHEDBAVFM5X6Q2WUTQSA, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by NVMT)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script2.js?token=GHSAT0AAAAAAEMU5J5MI7YYX7I4R25OG2SO2WUTRBA, timeout=60

# 3. Kích hoạt Gold & Ngày 09/12/2008 (by NMVT)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/minhtriet912/minhtriet/refs/heads/main/Script3.js?token=GHSAT0AAAAAAEMU5J5MRHLQIUHISI33BESW2WUTRUQ, requires-body=true, max-size=-1, timeout=60
